    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Back to top button
        const backToTopButton = document.getElementById('backToTop');
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                backToTopButton.style.display = 'block';
            } else {
                backToTopButton.style.display = 'none';
            }
        });

        // Shop Cart button visibility
        const shopButtonText = document.getElementById('shopButtonText');
        const shopButtonIcon = document.getElementById('shopButtonIcon');
        
        // Initialize shop buttons
        function initializeShopButtons() {
            // Set up text button
            shopButtonText.classList.add('btn', 'btn-success', 'btn-sm');
            shopButtonText.textContent = 'Shop Now';
            shopButtonText.style.transition = 'all 0.3s ease';
            
            // Set up icon button
            shopButtonIcon.innerHTML = '<img src="/asset/img/cart-shopping-svgrepo-com.png" alt="Cart" style="width: 20px; height: 20px; filter: brightness(0) invert(1);">';
            shopButtonIcon.classList.add('btn', 'btn-success', 'btn-sm', 'd-flex', 'align-items-center', 'justify-content-center');
            shopButtonIcon.style.width = '40px';
            shopButtonIcon.style.height = '40px';
            shopButtonIcon.style.padding = '0';
            shopButtonIcon.style.borderRadius = '50%';
            shopButtonIcon.style.transition = 'all 0.3s ease';
            
            // Initially show text button, hide icon button
            shopButtonText.style.display = 'block';
            shopButtonIcon.style.display = 'none';
        }

        // Function to show text button
        function showTextButton() {
            shopButtonText.style.display = 'block';
            shopButtonText.style.opacity = '0';
            
            @* setTimeout(() => {
            }, 10); *@
            
            shopButtonText.style.opacity = '1';
            shopButtonIcon.style.display = 'none';
        }

        // Function to show icon button
        function showIconButton() {
            shopButtonIcon.style.display = 'flex';
            shopButtonIcon.style.opacity = '0';
            
            @* setTimeout(() => {
            }, 10); *@
            
            shopButtonIcon.style.opacity = '1';
            shopButtonText.style.display = 'none';
        }

        // Scroll event for shop button transformation
        let lastScrollY = window.pageYOffset;
        
        window.addEventListener('scroll', function() {
            const currentScrollY = window.pageYOffset;
            
            // Show icon when scrolling down past 450px, show text when scrolling up
            if (currentScrollY > 600) {
                showIconButton();
            } else  {
                showTextButton();
            }
            
            lastScrollY = currentScrollY;

        backToTopButton.addEventListener('click', function() {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            initializeShopButtons();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
